#!/bin/bash
# Deploy Sock Shop to Kubernetes using Kustomize.
# Reads .build-manifest.json to determine per-service image tags.
#
# Usage:
#   ./bin/deploy --kind              Deploy to kind cluster (local dev images)
#   ./bin/deploy --eks               Deploy to EKS (ECR dev images)
#   ./bin/deploy --gke               Deploy to GKE (Artifact Registry dev images)
#   ./bin/deploy --eks --no-apply    Generate overlay only (skip kubectl apply)
#
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${REPO_ROOT}/.build-manifest.json"
NAMESPACE="sock-shop"
APP_DEPLOYMENTS=(carts catalogue orders front-end payment user shipping queue-master)

# --- Parse arguments ----------------------------------------------------------

TARGET=""
NO_APPLY=false
for arg in "$@"; do
  case "$arg" in
    --kind)     TARGET="kind" ;;
    --eks)      TARGET="eks" ;;
    --gke)      TARGET="gke" ;;
    --no-apply) NO_APPLY=true ;;
    *)          echo "Unknown argument: $arg"; echo "Usage: $0 --kind|--eks|--gke [--no-apply]"; exit 1 ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  echo "Error: specify --kind, --eks, or --gke"
  echo "Usage: $0 --kind|--eks|--gke [--no-apply]"
  exit 1
fi

# --- Read build manifest ------------------------------------------------------

if [[ ! -f "$MANIFEST" ]]; then
  echo "Error: .build-manifest.json not found. Run ./bin/build --${TARGET} first."
  exit 1
fi

MANIFEST_TARGET=$(python3 -c "import json; print(json.load(open('${MANIFEST}'))['target'])")
MANIFEST_TAG=$(python3 -c "import json; print(json.load(open('${MANIFEST}'))['tag'])")
MANIFEST_SHA=$(python3 -c "import json; print(json.load(open('${MANIFEST}'))['git_sha'])")

if [[ "$MANIFEST_TARGET" != "$TARGET" ]]; then
  echo "Warning: manifest was built for '${MANIFEST_TARGET}' but deploying to '${TARGET}'."
  echo "Run ./bin/build --${TARGET} to rebuild for the correct target."
  exit 1
fi

echo "Deploying Sock Shop (target: ${TARGET})"
echo "  Manifest: ${MANIFEST_TAG} (${MANIFEST_SHA})"
echo ""

# --- VCS pod annotations ------------------------------------------------------
# Each service pod is annotated with its repo URL and commit. The collector's
# k8sattributes processor (extract.otel_annotations) turns
# resource.opentelemetry.io/<attr> annotations into resource attributes, so
# every log line and span from the pod carries vcs.repository.url.full and
# vcs.ref.head.revision.

MANIFEST_DIRTY=$(python3 -c "import json; print(json.load(open('${MANIFEST}')).get('dirty', False))")
MANIFEST_SHA_FULL=$(python3 -c "import json; print(json.load(open('${MANIFEST}')).get('git_sha_full', ''))")

VCS_URL=$(git -C "${REPO_ROOT}" remote get-url origin 2>/dev/null || true)
case "$VCS_URL" in
  git@github.com:*)     VCS_URL="https://github.com/${VCS_URL#git@github.com:}" ;;
  https://github.com/*) ;;
  *)                    VCS_URL="" ;;
esac
VCS_URL="${VCS_URL%.git}"
if [[ -z "$VCS_URL" ]]; then
  echo "Warning: cannot derive a GitHub URL from 'git remote get-url origin'; omitting the vcs.repository.url.full annotation."
fi

VCS_REV=""
if [[ "$MANIFEST_DIRTY" == "True" ]]; then
  echo "Warning: dirty build (${MANIFEST_TAG}) does not match commit ${MANIFEST_SHA}; omitting the vcs.ref.head.revision annotation."
elif [[ -n "$MANIFEST_SHA_FULL" ]]; then
  VCS_REV="$MANIFEST_SHA_FULL"
elif VCS_REV=$(git -C "${REPO_ROOT}" rev-parse --verify --quiet "${MANIFEST_SHA}^{commit}"); then
  :
else
  echo "Warning: manifest has no git_sha_full and ${MANIFEST_SHA} is not a known commit; omitting the vcs.ref.head.revision annotation."
fi
export VCS_URL VCS_REV

# --- Generate kustomization.yaml from manifest --------------------------------

OVERLAY="${REPO_ROOT}/deploy/kubernetes/overlays/${TARGET}"
GENERATED_KUSTOMIZATION="${OVERLAY}/kustomization.yaml"

{
  echo "# Generated by bin/deploy — do not edit manually."
  echo "# Build: ${MANIFEST_TAG} ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  echo "apiVersion: kustomize.config.k8s.io/v1beta1"
  echo "kind: Kustomization"
  echo ""
  echo "resources:"
  echo "  - ../../manifests"
  echo ""
  echo "images:"

  python3 -c "
import json
m = json.load(open('${MANIFEST}'))
for svc, info in m['services'].items():
    img = info['image']
    tag = info['tag']
    # image_name is registry/repo:tag — split into name and tag
    name_part = img.rsplit(':', 1)[0]
    # For kind: name stays as weaveworksdemos/<svc>, we only set newTag
    # For eks: name changes to ECR URI, we set both newName and newTag
    if '${TARGET}' == 'kind':
        print(f'  - name: weaveworksdemos/{svc}')
        print(f'    newTag: \"{tag}\"')
    else:
        print(f'  - name: weaveworksdemos/{svc}')
        print(f'    newName: {name_part}')
        print(f'    newTag: \"{tag}\"')
"

  python3 -c "
import json, os
m = json.load(open('${MANIFEST}'))
annotations = {
    'resource.opentelemetry.io/vcs.repository.url.full': os.environ['VCS_URL'],
    'resource.opentelemetry.io/vcs.ref.head.revision': os.environ['VCS_REV'],
}
annotations = {k: v for k, v in annotations.items() if v}
if annotations:
    # One strategic-merge patch for the service Deployments built from this
    # repo; the -db, rabbitmq and session-db Deployments run upstream images.
    names = '|'.join(m['services'])
    print('')
    print('patches:')
    print('  - target:')
    print('      kind: Deployment')
    print(f'      name: ^({names})$')
    print('    patch: |-')
    print('      apiVersion: apps/v1')
    print('      kind: Deployment')
    print('      metadata:')
    print('        name: not-used')
    print('      spec:')
    print('        template:')
    print('          metadata:')
    print('            annotations:')
    for k, v in annotations.items():
        print(f'              {k}: {v}')
"
} > "$GENERATED_KUSTOMIZATION"

echo "Generated ${GENERATED_KUSTOMIZATION}"

if [[ "$NO_APPLY" == "true" ]]; then
  echo ""
  echo "--no-apply: skipping kubectl apply and rollout."
  echo "To apply manually: kubectl apply -k ${OVERLAY}"
  exit 0
fi

# --- Apply --------------------------------------------------------------------

echo ""
echo "Applying with Kustomize overlay (${TARGET})..."
kubectl apply -k "${OVERLAY}"

echo ""
echo "Restarting deployments to pick up latest images..."
for dep in "${APP_DEPLOYMENTS[@]}"; do
  kubectl rollout restart deployment/"${dep}" -n "${NAMESPACE}"
done

echo ""
echo "Waiting for deployments to roll out..."
for dep in "${APP_DEPLOYMENTS[@]}"; do
  echo "  Waiting for ${dep}..."
  kubectl rollout status deployment/"${dep}" -n "${NAMESPACE}" --timeout=300s 2>/dev/null || \
    echo "  WARNING: ${dep} did not become ready within 300s"
done

echo ""
echo "Deployment complete."
echo ""
echo "Current status:"
kubectl get pods -n "${NAMESPACE}"
echo ""
echo "Images in use:"
kubectl get deployments -n "${NAMESPACE}" \
  -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.template.spec.containers[0].image}{"\n"}{end}' | column -t
echo ""
echo "To access the front-end: ./bin/port-forward"
